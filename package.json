{
  "name": "sop-forge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist-electron/apps/desktop/src/main.js",
  "description": "Local-first SOP recording and authoring desktop application",
  "author": "SOP Forge",
  "scripts": {
    "dev": "concurrently -k \"npm run dev:server\" \"npm run dev:web\"",
    "dev:server": "tsx watch apps/server/src/index.ts",
    "dev:web": "vite --config vite.config.ts",
    "build:web": "vite build --config vite.config.ts",
    "build:electron": "tsc -p tsconfig.electron.json",
    "dev:desktop": "npm run build:web && npm run build:electron && node scripts/desktop-dev.mjs",
    "smoke:desktop": "npm run build:web && npm run build:electron && node scripts/desktop-smoke.mjs",
    "playwright:install:bundled": "cross-env PLAYWRIGHT_BROWSERS_PATH=0 playwright install chromium",
    "package:dir": "npm run build:web && npm run build:electron && npm run playwright:install:bundled && node scripts/electron-builder.mjs --dir",
    "package:mac": "npm run build:web && npm run build:electron && npm run playwright:install:bundled && node scripts/electron-builder.mjs --mac dmg zip",
    "package:win": "npm run build:web && npm run build:electron && npm run playwright:install:bundled && node scripts/electron-builder.mjs --win nsis --x64",
    "build": "tsc --noEmit && vite build --config vite.config.ts",
    "start": "tsx apps/server/src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "playwright:install": "playwright install chromium"
  },
  "dependencies": {
    "@fastify/static": "^8.2.0",
    "@fastify/websocket": "^11.2.0",
    "archiver": "^8.0.0",
    "better-sqlite3": "^12.4.1",
    "fabric": "^7.4.0",
    "fastify": "^5.6.1",
    "handlebars": "^4.7.8",
    "playwright": "^1.55.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "sharp": "^0.34.3",
    "zod": "^4.1.8"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/archiver": "^8.0.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.5.2",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.4",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^44.4.2",
    "electron-builder": "^26.15.3",
    "jsdom": "^29.1.1",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vite": "^7.1.7",
    "vitest": "^3.2.4"
  },
  "build": {
    "appId": "com.sopforge.desktop",
    "productName": "SOP Forge",
    "asar": true,
    "asarUnpack": [
      "node_modules/better-sqlite3/**/*",
      "node_modules/sharp/**/*",
      "node_modules/playwright-core/**/*"
    ],
    "extraResources": [
      {
        "from": "node_modules/playwright-core/.local-browsers",
        "to": "playwright-browsers"
      }
    ],
    "directories": {
      "output": "release"
    },
    "mac": {
      "target": [
        { "target": "dmg", "arch": ["x64", "arm64"] },
        { "target": "zip", "arch": ["x64", "arm64"] }
      ],
      "artifactName": "${productName}-${version}-${os}-${arch}.${ext}"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "${productName}-${version}-${os}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
